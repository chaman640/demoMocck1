import User from "../models/User.js";

// 🐛 FIX: regex special characters escape karna zaroori hai.
// Pehle user ka input seedha `new RegExp` mein jata tha. Agar koi "(" ya "["
// jaisa character daal deta to MongoDB "Regular expression is invalid" ke saath
// 500 error de deta tha. "." bhejne par TOH poori batch ke students dikh jate the.
const escapeRegex = (str) => str.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");

export const searchStudentByPhone = async (req, res) => {
  try {
    const { phone } = req.query;

    if (!phone || String(phone).trim().length < 3) {
      return res.status(400).json({
