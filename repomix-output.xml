      if (meta?.mockType === "Mini") {
        (meta.subjectNames || []).forEach((s) => set.add(s));
      }
    });
    return Array.from(set).sort();
  }, [sortedHistory, blueprintMetaMap]);

  // Level-2 (Mini ke andar subject) tabs ke counts
