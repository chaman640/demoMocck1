      } = req.body;

      if (
        !question ||
        !option1 ||
        !option2 ||
        !option3 ||
        !option4 ||
        !subjectName ||
        !topicName ||
        !answerExplain
      ) {
        return res.status(400).json({ success: false, message: "❌ Sabhi fields zaroori hain!" });
