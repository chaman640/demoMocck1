    const [quiz, attempt] = await Promise.all([
      CurrentAffairQuiz.findOne({ examName, date }),
      CurrentAffairAttempt.findOne({ userId, examName, date }),
    ]);

    if (!quiz) return res.status(404).json({ success: false, message: "Quiz nahi mila." });
