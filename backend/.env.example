# backend/.env.example
# Isko copy karke ".env" banayein aur apni asli values daalein.
# .env kabhi git mein commit na karein.

# ═══════════════════════════════════════════
# ── Server ──
# ═══════════════════════════════════════════
PORT=5000

# Local dev mein ise "development" hi rakhein (cookie http pe kaam karegi).
# Render/production pe HAMESHA "production" set karein — warna:
#   • cookies "secure" nahi hongi
#   • HSTS band rahega
#   • error messages mein server ka andar ka detail user tak chala jayega
NODE_ENV=development

# Frontend ka URL — CORS ke liye, aur email links (admin magic-link, teacher
# invite) isi se banate hain. Local dev: http://localhost:5173
# Production: apna Render frontend URL (jaise https://frontend-xxxx.onrender.com)
FRONTEND_URL=http://localhost:5173

# ═══════════════════════════════════════════
# ── Database ──
# ═══════════════════════════════════════════
ROWQUESTION_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/MOCKTEST?retryWrites=true&w=majority

# ═══════════════════════════════════════════
# ── Auth ──
# ═══════════════════════════════════════════
# ⚠️ SABSE ZAROORI. Kam se kam 32 characters (64+ behtar).
JWT_SECRET=

# ═══════════════════════════════════════════
# ── Cloudinary (question/answer images) ──
# ═══════════════════════════════════════════
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ═══════════════════════════════════════════
# 🆕 ── Email (OTP / admin login link / teacher invite) — FREE ──
# ═══════════════════════════════════════════
# ⚠️ Gmail SMTP NAHI use kar rahe — Render ka free tier Sept 2025 se saare
# outbound SMTP ports (465/587/25) block kar deta hai, koi bhi SMTP config
# wahan kaam nahi karega. Isliye Brevo ki HTTPS API use ho rahi hai
# (port 443, kabhi block nahi hota).
#
# Setup (5 min, free, card nahi chahiye):
#   1. https://app.brevo.com/ par account banayein
#   2. Settings → SMTP & API → API Keys → naya key banayein  ->  BREVO_API_KEY
#   3. Senders → Add a sender → apna email daalein → uspar aaya 6-digit code
#      verify karein (koi domain/DNS nahi chahiye)  ->  BREVO_SENDER_EMAIL
#   ⚠️ Naye account ka pehla email jaane se pehle Brevo ka ek chhota manual
#   approval lagta hai — turant na chale to thodi der baad dobara try karein.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=BatchMock.in

# ═══════════════════════════════════════════
# ── Admin access ──
# ═══════════════════════════════════════════
# 🆕 Tarika A (browser): Admin Login page (/#/AdminLogin) se "Send Login
# Link" dabayein — is email par ek magic link jayega, click karte hi 12
# ghante ke liye admin panel access ho jayega. Session khatam hone par
# (logout ya 12 ghante) naya link mangwana padega.
ADMIN_EMAIL=

# Tarika B (Postman/script): header bhejein  ->  x-admin-secret: <ye wali value>
ADMIN_SECRET=

# ═══════════════════════════════════════════
# ── Round 1 ke naye (optional) settings ──
# Inko chhod dein to sensible defaults lag jaate hain.
# ═══════════════════════════════════════════

# ── Rate limits ──
# GLOBAL_RATE_LIMIT=3000   # poore /api par, per IP, 15 minute mein
# OTP_PHONE_LIMIT=5        # ek email par, 1 ghante mein
# OTP_IP_LIMIT=60          # ek IP se, 1 ghante mein
# LOGIN_LIMIT=10           # galat password — per IP+phone AUR per IP+email, 15 min
# LOGIN_IP_LIMIT=200       # galat password, poore IP par, 15 minute mein (backstop)
# SIGNUP_LIMIT=10          # per IP+phone/email, 1 ghante mein
# SIGNUP_IP_LIMIT=120      # poore IP par, 1 ghante mein
# ADMIN_LIMIT=60           # per IP, 15 minute mein
# WRITE_LIMIT=60           # per LOGGED-IN USER, 1 minute mein

# Ek request mein zyada se zyada kitne questions bulk upload ho sakte hain
# MAX_BULK_QUESTIONS=300

# JSON body ki max size (bulk upload ke liye)
# JSON_BODY_LIMIT=2mb

# MongoDB connection pool ka size (Render free plan pe 10 kaafi hai)
# MONGO_MAX_POOL=10

# 🚨 Ise KABHI "true" mat karein production mein — server start hi nahi hoga.
# MONGO_ALLOW_INSECURE_TLS=false

# Agar Content-Security-Policy ki wajah se site par kuch toot jaye
# (images/styles load na hon), to isse turant band kar sakte hain.
# DISABLE_CSP=false
