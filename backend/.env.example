# backend/.env.example
# Isko copy karke ".env" banayein aur apni asli values daalein.
# .env kabhi git mein commit na karein.

# ── Server ──
PORT=5000
# Local dev mein ise "development" hi rakhein (cookie http pe kaam karegi).
# Render/production pe HAMESHA "production" set karein.
NODE_ENV=development

# Agar frontend alag domain pe hai (dev mein zaroori nahi, proxy laga hua hai)
FRONTEND_URL=http://localhost:5173

# ── Database ──
ROWQUESTION_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/MOCKTEST?retryWrites=true&w=majority

# ── Auth ──
# Lamba random string rakhein. Isko badalne se sabhi logged-in users logout ho jayenge.
JWT_SECRET=koi_bahut_lamba_random_secret_yahan_daalein

# ── Cloudinary (question/answer images) ──
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── OTP SMS (2Factor.in) ──
FAST2SMS_API_KEY=

# ── Admin access (add-question / add-bluePrint / add-previous-year-test etc.) ──
# Tarika A (Postman): header bhejein  ->  x-admin-secret: <ADMIN_SECRET wali value>
ADMIN_SECRET=koi_lamba_random_admin_secret
# Tarika B (browser): is email wale student account se login rahein
ADMIN_EMAIL=aapka@email.com
